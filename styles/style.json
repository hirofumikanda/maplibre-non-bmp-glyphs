{
  "version": 8,
  "glyphs": "fonts/{fontstack}/{range}.pbf",
  "sources": {
    "basemap": {
      "type": "raster",
      "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256,
      "maxzoom": 19,
      "attribution": "&copy; <a href=\"https://www.openstreetmap.org/copyright\" target=\"_blank\">OpenStreetMap contributors</a>"
    },
    "tohokumachi": {
      "type": "geojson",
      "data": "../geojson/tohokumachi.geojson",
      "attribution": "<a href=\"https://github.com/geolonia/japanese-addresses-v2\" target=\"_blank\">Geolonia 住所データツールv2</a>のデータを一部改変"
    }
  },
  "layers": [
    {
      "id": "basemap",
      "type": "raster",
      "source": "basemap",
      "paint": {
        "raster-opacity": 0.3
      }
    },
    {
      "id": "machi-aza",
      "type": "symbol",
      "source": "tohokumachi",
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans JP Regular"],
        "text-size": 13,
        "text-anchor": "center"
      },
      "paint": {
        "text-color": "#000",
        "text-halo-color": "#ffffff",
        "text-halo-width": 1
      },
      "minzoom": 10
    }
  ]
}
